# Names only. Put values in .env (never commit it).
ANTHROPIC_API_KEY=
# Market Pulse (#260): 1 lets Claude write each losing seller's "what to change" line; unset uses the SIM template
PULSE_CLAUDE=
AGENTVERSE_API_KEY=
ASI1_API_KEY=
APIFY_TOKEN=
# Prepaid Apify token an agent bought itself (data/claim_check/agent_pay.py writes it to .env); a hard spend cap, $1 to $10 per run
APIFY_AGENT_TOKEN=
# Bright Data Scraper API: BRIGHT_DATA_MAX_CALLS is optional, calls allowed per process (default 8; each call is one credit per record)
BRIGHT_DATA_MAX_CALLS=
BRIGHT_DATA_API_KEY=
# CRS sandbox login credentials. The adapter logs in once per process and latches failed login.
CRS_USERNAME=
CRS_PASSWORD=
# Optional API base URL, default https://api-sandbox.stitchcredit.com/api.
CRS_BASE_URL=
# Optional preissued CRS bearer token; when present, login is skipped.
CRS_API_KEY=
# Absolute path to a private JSON file with approved synthetic CRS persona bodies; never commit it.
CRS_TEST_IDENTITIES_PATH=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
VISA_VIC_API_KEY=
VISA_TAP_PRIVATE_KEY_PATH=
# Server secret for approval codes: random, at least 16 characters, never committed
APPROVAL_SECRET=
CARTESIA_API_KEY=
CARTESIA_AGENT_ID=
# Cartesia phone number id (ap_...) sent as from_number_id; optional, the agent's own number is used when blank
CARTESIA_PHONE_NUMBER_ID=
# The ONE phone the approval call may ever dial (E.164, the buyer's own phone)
APPROVAL_CALL_TO=
# Beta: comma-separated E.164 numbers the approval call may ring; blank means no limit (#449 item 1)
APPROVAL_CALL_ALLOWLIST=
# Path of the approval call rate cap file (1 call per number per 5 min, 20 per day); blank uses agents/.state/approval_call_rate.json
APPROVAL_CALL_RATE_FILE=
# First name the approval call greets (default Vidyut)
APPROVAL_BUYER_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SPACETIMEDB_URI=
TIGER_DATA_SERVICE_URL=
SPACETIMEDB_HTTP=
SPACETIMEDB_DB=
SPACETIMEDB_TOKEN_FILE=
NEXT_PUBLIC_SPACETIMEDB_URI=
NEXT_PUBLIC_SPACETIMEDB_DB=
# Agent feed for the Fetch tile (scripts/agent_feed.py). Unset, or loopback seen from a deployed page: the tile shows Agentverse links.
NEXT_PUBLIC_AGENT_FEED_URL=
# Optional bearer token for the feed's /v1/memory and /v1/build (scripts/agent_feed.py, #449 PL-17). Set: both routes need
# `Authorization: Bearer <token>` and ?buyer=<id>, and return only that buyer's rows. Browser pages cannot hold it, so they show the
# feed as unreachable; a server-side caller passes it. Never put it in a NEXT_PUBLIC_ variable. Unset: open on 127.0.0.1, as before.
AGENT_FEED_TOKEN=
BUYER_AGENT_SEED=
ADVOCATE_AGENT_SEED=
SELLER_1_AGENT_SEED=
SELLER_2_AGENT_SEED=
SELLER_3_AGENT_SEED=
# seller_6 (Central Computers MIRROR, #342): no default seed, it stays off until this holds a private seed of 16+ characters
SELLER_6_AGENT_SEED=
SHIELD_AGENT_SEED=
SHIELD_URL=
# Agent depth (optional). ADVOCATE_ASK_TIMEOUT_S: seconds the Advocate waits for a seller's one clarifying answer (default 4).
# ADVOCATE_TRACK_FILE: a JSON file of seller track records for the total-cost ranking. SMELL_QUARANTINE_FILE: the shared quarantine
# list (default ~/.bazaar-shield/quarantine.json, "off" disables), SMELL_QUARANTINE_TTL_S (default 21600), SMELL_QUARANTINE_MAX (default 200).
# PHRASING_LLM=0 turns off the model that may reword explanations (it needs ANTHROPIC_API_KEY, model claude-haiku-5-5, 3 s timeout).
ADVOCATE_ASK_TIMEOUT_S=
ADVOCATE_TRACK_FILE=
SMELL_QUARANTINE_FILE=
SMELL_QUARANTINE_TTL_S=
SMELL_QUARANTINE_MAX=
PHRASING_LLM=
# Shield signed allow receipts: the Shield signer's Ed25519 key file, and the comma-separated public keys MerchantSim trusts.
SHIELD_RECEIPT_PRIVATE_KEY_PATH=
SHIELD_RECEIPT_PUBKEYS=
# Existing registered role token files; no runtime identity is created when either is absent.
SPACETIMEDB_BUYER_TOKEN_FILE=
SPACETIMEDB_REFEREE_TOKEN_FILE=
# Exact authenticated buyer chat sender address approved by the operator for purchases.
MARKET_BUYER_OWNER_SENDER=
# Optional shared runtime path for sanitized supplier signals; defaults to agents/.cache/crs-signals.json.
CRS_SIGNAL_CACHE_PATH=
# Shield-only Ed25519 key that signs short-lived exact-request allow receipts (never the buyer's TAP key).
SHIELD_RECEIPT_PRIVATE_KEY_PATH=
# Buyer-side comma-separated base64 raw Ed25519 public keys for Shield receipt verification.
SHIELD_RECEIPT_PUBKEYS=
# Seller Kit (#197): operator token required for POST /v1/sellers?replace=true (X-Operator-Token header); unset = replace refused
SELLER_KIT_OPERATOR_TOKEN=
# Agent feed GET /v1/memory (#189): folder of demo run files and market memory snapshots; defaults to demo/out
MEMORY_DIR=
# Bazaar Caller agent (#259): its own seed before going on Agentverse (the default is public), optional handle.
# The Caller also refuses to start unless BUYER_AGENT_SEED above is a private seed (#449 PL-22): it obeys only that address.
CALLER_AGENT_SEED=
CALLER_AGENT_HANDLE=
# Fetch discoverability (#383). Each agent put on Agentverse needs its own private seed (the dev defaults are public).
SELLER_4_AGENT_SEED=
SELLER_5_AGENT_SEED=
# 1 puts that agent on Agentverse as a mailbox agent (AGENTS_MAILBOX=1 turns on every agent that uses agents/common.py)
AGENTS_MAILBOX=
SELLERS_MAILBOX=
CALLER_MAILBOX=
# Market Pulse (python agents/pulse/orchestrator.py --serve, port 8018): private seed, mailbox flag, optional handle
PULSE_AGENT_SEED=
PULSE_MAILBOX=
PULSE_AGENT_HANDLE=
# Market Pulse accepts a finished round only from these agent addresses, comma separated: the referee agent's address and
# the operator's agent address (copy each from its Agentverse page). Unset means no round is accepted.
PULSE_ROUND_SENDERS=
# open lets any chat sender read any seller's record from Market Pulse; unset (default) answers a record only to its own seller agent
PULSE_SELLER_CHAT=
# FlashDeal Frankie (seller_3) plays only the tricks the live buyer path catches (condition lie, injection line). 1 adds
# the hidden fee and fake warranty tricks, which only the offline claim check catches: leave unset for any filmed round
SELLER3_EXTRA_TRICKS=
# Startup default market buyerId for chat-started goals (web sign-ups carry their own)
MARKET_BUYER_ID=
