  },
  "sku_spec": {
   "type": "string"
  },
  "item_name": {
   "type": "string"
  },
  "grade": {
   "type": "string"
  },
  "pack_size": {
   "type": "string"
  },
  "case_count": {
   "type": "number"
  },
  "unit": {
   "type": "string"
  },
  "allowed_substitutes": {
