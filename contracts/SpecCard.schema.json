{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "SpecCard",
 "description": "One part, normalized. attrs keys per category are listed in data/fit_checker/README.md. A missing attr means unknown; the fit checker answers uncertain, never a guess.",
 "type": "object",
 "properties": {
  "id": {
   "type": "string"
  },
  "category": {
   "type": "string",
   "enum": [
    "cpu",
    "motherboard",
    "memory",
    "gpu",
    "psu",
    "case",
    "cooler",
    "storage",
    "monitor",
    "peripheral",
    "laptop"
   ]
  },
  "name": {
   "type": "string"
  },
  "model_number": {
   "type": "string"
  },
  "condition": {
   "type": "string",
   "enum": [
    "new",
    "open-box",
    "refurbished",
    "used",
    "unknown"
   ]
  },
  "variant": {
   "type": "string"
  },
  "attrs": {
   "type": "object"
  },
  "price": {
   "type": "number"
  },
  "currency": {
   "type": "string"
  },
  "origin": {
   "type": "string",
   "enum": [
    "LIVE",
    "MIRROR",
    "SIM"
   ]
  },
  "source": {
   "type": "string",
   "description": "listing URL, actor id or dataset id"
  },
  "snapshot_id": {
   "type": "string"
  },
  "snapshot_date": {
   "type": "string"
  },
  "listing": {
   "type": "object",
   "description": "MIRROR/LIVE offer facts as seen at snapshot time: url, price, was_price, shipping, seller, return_policy, stock, sold_date. Absent key = not on the page.",
   "properties": {
    "url": {},
    "price": {},
    "was_price": {},
    "shipping": {},
    "seller": {},
    "return_policy": {},
    "stock": {},
    "sold_date": {}
   }
  }
 },
 "required": [
  "id",
  "category",
  "name",
  "attrs",
  "origin",
  "source"
 ]
}