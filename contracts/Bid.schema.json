{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string"
  },
  "need_id": {
   "type": "string"
  },
  "persona": {
   "type": "string"
  },
  "lines": {
   "type": "array",
   "description": "Alternatives per SKU, not a basket: for each need item the market picks the cheapest line with an allowed condition and enough qty_available, and never sums a line with its alternatives.",
   "items": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
     "sku_spec": {
      "type": "string"
     },
     "unit_price": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "shipping": {"type": "number", "minimum": 0,
       "description": "Flat shipping for this line at its quantity; market adds it once. Omitted only for legacy bids."},
     "listing_id": {"type": "string"},
     "line_index": {"type": "integer", "minimum": 0,
       "description": "Original zero-based Bid.lines index assigned by the market when selecting this line for review."},
     "quantity": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Deprecated alias of qty_available"
     },
     "qty_available": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "condition": {
      "type": "string",
      "enum": ["new", "open-box", "refurbished", "used"]
     },
     "offered_spec": {
      "type": "string"
     },
     "offered_condition": {
      "type": "string",
      "enum": [
       "new",
       "open-box",
       "refurbished",
       "used",
       "unknown"
      ]
     },
     "origin": {"type": "string", "enum": ["LIVE", "MIRROR", "SIM"]},
     "source": {"type": "string"},
     "seller_of_record": {"type": "string"},
     "model_number": {"type": "string"},
     "snapshot_id": {"type": "string"},
     "snapshot_date": {"type": "string"},
     "floor_evidence": {"type": "object",
       "properties": {"origin": {"type": "string", "const": "MIRROR"}, "source": {"type": "string"}, "observed_at": {"type": "string"}},
       "required": ["origin", "source", "observed_at"], "additionalProperties": false,
       "description": "Public floor evidence provenance only; the numeric private floor is excluded."},
     "shipping_evidence": {"type": "object"}
    },
    "required": [
     "sku_spec",
     "unit_price"
    ],
    "anyOf": [
     {"required": ["qty_available"]},
     {"required": ["quantity"]}
    ]
     }
  },
  "total_landed_price": {
   "type": "number"
  },
  "perks": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "claims": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "floor_check_passed": {
   "type": "boolean"
  },
  "mirror_snapshot_id": {
   "type": "string"
  },
  "decision_trace": {
   "type": "string"
  },
  "expires_at": {
   "type": "string"
  },
  "source": {
   "type": "string",
   "description": "listing URL, actor id or dataset id"
  },
  "origin": {
   "type": "string",
   "enum": [
    "LIVE",
    "MIRROR",
    "SIM"
   ]
  },
  "seller_id": {
   "type": "string"
  },
  "supplier_id": {
   "type": "string",
   "description": "Deprecated alias of seller_id, still sent by Lane A; the market reads it as seller_id"
  },
  "seller_of_record": {"type": "string", "description": "Merchant named by the MIRROR listing; not the registered agent or payment payee."}
 },
 "required": [
  "id",
  "need_id",
  "persona",
  "lines",
  "total_landed_price",
  "perks",
  "claims",
  "floor_check_passed",
  "mirror_snapshot_id",
  "decision_trace",
  "expires_at",
  "source",
  "origin"
 ],
 "anyOf": [
  {
   "required": [
    "seller_id"
   ]
  },
  {
   "required": [
    "supplier_id"
   ]
  }
 ],
 "allOf": [{
  "if": {"properties": {"origin": {"const": "MIRROR"}}, "required": ["origin"]},
  "then": {
   "required": ["seller_of_record"],
   "properties": {"lines": {"items": {"required": ["offered_condition", "shipping", "listing_id",
                                                       "seller_of_record", "snapshot_id", "snapshot_date",
                                                       "floor_evidence", "shipping_evidence"]}}}
  }
 }]
}
