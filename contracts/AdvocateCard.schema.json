{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "need_id": {
   "type": "string"
  },
  "bid_id": {
   "type": "string"
  },
  "warnings": {
   "type": "array",
   "items": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "kind": {
      "type": "string",
      "enum": ["condition", "fit", "fit_unknown", "spec", "price", "recall", "record", "floor", "unsourced", "note"]
     },
     "text": {
      "type": "string",
      "maxLength": 600
     },
     "source_url": {
      "type": "string",
      "maxLength": 2048
     },
     "dollar_impact": {
      "type": "number"
     },
     "rule_id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
     },
     "checked_at": {
      "type": "string",
      "maxLength": 40
     },
     "evidence_hash": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^(sha256:)?[0-9a-f]{0,64}$"
     }
    },
    "required": [
     "kind",
     "text",
     "source_url",
     "dollar_impact"
    ]
   }
  },
  "claim_checks": {
   "type": "array",
   "maxItems": 9,
   "items": {
    "type": "object",
    "properties": {
     "bid_id": {"type": "string"}, "line_index": {"type": "integer", "minimum": 0},
     "listing_id": {"type": "string"}, "sku_spec": {"type": "string"},
     "field": {"type": "string", "const": "condition"},
     "value": {"type": "string", "enum": ["new", "open-box", "refurbished", "used"]},
     "result": {"type": "string", "enum": ["verified", "unverified", "false"]},
     "evidence_url": {"type": "string"}, "evidence_hash": {"type": "string"},
     "checked_at": {"type": "string"}, "source": {"type": "string"},
     "origin": {"type": "string", "enum": ["LIVE", "MIRROR", "SIM"]}
    },
    "required": ["bid_id", "line_index", "listing_id", "sku_spec", "field", "value", "result",
                 "evidence_url", "evidence_hash", "checked_at", "source", "origin"],
    "additionalProperties": false
   }
  },
  "recommendation": {
   "type": "string",
   "enum": ["buy", "caution", "veto"]
  },
  "call_reason": {
    "type": "object",
    "properties": {
      "rule_id": {"type": "string", "enum": ["advocate.condition", "advocate.recall", "advocate.price", "advocate.spec", "advocate.record", "advocate.floor", "advocate.unsourced", "advocate.fit_unknown", "fit.gpu_length", "fit.psu_wattage", "fit.gpu_connectors", "fit.cpu_socket", "fit.ram_type", "fit.form_factor", "fit.psu_form_factor", "fit.cooler_height", "fit.cooler_socket", "fit", "advocate.ok"]},
      "summary": {"type": "string", "enum": ["The listing page shows a different condition than the seller claims", "This product matches a CPSC recall entry", "The price is more than 10 percent above its price history", "This offer is not the condition you asked for", "This seller has a caution record", "This bid did not pass the price floor check", "A claim on this bid could not be checked against its listing", "Fit could not be confirmed from the listing details", "The card is longer than your case allows", "Your power supply is below what this card needs", "Your power supply lacks the connectors this card needs", "The processor socket does not match the board", "The memory type does not match the board", "The board does not fit your case", "The power supply does not fit your case", "The cooler is taller than your case allows", "The cooler does not support this processor socket", "This part does not fit your build", "No problems found in the checks"]},
      "source_url": {"type": "string", "minLength": 1, "pattern": "^https?://"}
    },
    "required": ["rule_id", "summary", "source_url"],
    "additionalProperties": false
  },
  "rule_id": {"type": "string", "enum": ["advocate.condition", "advocate.recall", "advocate.price", "advocate.spec", "advocate.record", "advocate.floor", "advocate.unsourced", "advocate.fit_unknown", "fit.gpu_length", "fit.psu_wattage", "fit.gpu_connectors", "fit.cpu_socket", "fit.ram_type", "fit.form_factor", "fit.psu_form_factor", "fit.cooler_height", "fit.cooler_socket", "fit", "advocate.ok"]},
  "reason": {"type": "string", "enum": ["The listing page shows a different condition than the seller claims", "This product matches a CPSC recall entry", "The price is more than 10 percent above its price history", "This offer is not the condition you asked for", "This seller has a caution record", "This bid did not pass the price floor check", "A claim on this bid could not be checked against its listing", "Fit could not be confirmed from the listing details", "The card is longer than your case allows", "Your power supply is below what this card needs", "Your power supply lacks the connectors this card needs", "The processor socket does not match the board", "The memory type does not match the board", "The board does not fit your case", "The power supply does not fit your case", "The cooler is taller than your case allows", "The cooler does not support this processor socket", "This part does not fit your build", "No problems found in the checks"]},
  "source_url": {"type": "string", "minLength": 1, "pattern": "^https?://"},
  "explanation": {
    "type": "object",
    "properties": {"text": {"type": "string", "maxLength": 160}, "source_url": {"type": "string"},
                   "status": {"type": "string", "enum": ["claude", "template_fallback"]}},
    "required": ["text", "source_url", "status"],
    "additionalProperties": false
  },
  "wait_until": {
   "type": "string"
  }
 },
 "additionalProperties": false,
 "required": [
  "need_id",
  "bid_id",
  "warnings",
  "recommendation",
  "wait_until"
 ],
 "dependentRequired": {
  "claim_checks": ["rule_id", "reason", "source_url", "call_reason"],
  "rule_id": ["claim_checks", "reason", "source_url", "call_reason"],
  "reason": ["claim_checks", "rule_id", "source_url", "call_reason"],
  "source_url": ["claim_checks", "rule_id", "reason", "call_reason"],
  "call_reason": ["claim_checks", "rule_id", "reason", "source_url"]
 }
}
