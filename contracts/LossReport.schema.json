{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "id": {
   "type": "string"
  },
  "round_id": {
   "type": "string"
  },
  "seller_id": {
   "type": "string"
  },
  "won": {
   "type": "boolean"
  },
  "gap_band": {
   "type": "string",
   "enum": [
    "within5",
    "within10",
    "within20",
    "over20"
   ]
  },
  "reason": {
   "type": "string",
   "enum": [
    "price",
    "fit",
    "condition",
    "delivery",
    "record",
    "advocate_veto"
   ]
  },
  "source_url": {
   "type": "string"
  },
  "created_at": {
   "type": "string"
  }
 },
 "required": [
  "id",
  "round_id",
  "seller_id",
  "won",
  "gap_band",
  "reason",
  "source_url",
  "created_at"
 ]
}